---
const highlighted = "digital";
---

<footer
  class="section f-panel footer section_footer"
  id="contact"
  data-type="vertical"
  data-id="footer"
>
  <div class="footer-container ">
    <div class="footer-top">
      <div class="footer-cta">
        <h2 class="footer-heading">
          Transforming ideas into exceptional

          {
            Array.from(highlighted).map((char) => (
              <span class="italic effect">{char}</span>
            ))
          }

          <br />
          experiences through expertise and innovation
        </h2>
        <button class="cta-button">
          Contact
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M1 8H15M15 8L8 1M15 8L8 15"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div>
      <nav class="footer-nav">
        <div class="nav-column">
          <h3 class="nav-title">Menu</h3>
          <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#work">Werk</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>

        <div class="nav-column">
          <h3 class="nav-title">Socials</h3>
          <ul class="nav-links">
            <li><a href="#linkedin">Linkedin</a></li>
            <li><a href="#instagram">Instagram</a></li>
          </ul>
        </div>

        <!-- <div class="nav-column">
          <h3 class="nav-title">Contact</h3>
          <ul class="nav-links">
            <li><a href="mailto:victorarango.dev@gmail.com">victorarango.dev@gmail.com</a></li>
          </ul>
        </div> -->
      </nav>
    </div>

    <div class="footer-brand">
      <div class="brand-text">va dev</div>
    </div>
    <div>
      <div class="footer-mail">
        <a href="mailto:victorarango.dev@gmail.com"
          >victorarango.dev@gmail.com</a
        >
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const mm = gsap.matchMedia();

  mm.add(
    {
      isDesktop: "(min-width: 851px)",
      isMobile: "(max-width: 850px)",
      reduceMotion: "(prefers-reduced-motion: reduce)",
    },
    (context) => {
      const { isDesktop, reduceMotion } = context.conditions as {
        isDesktop: boolean;
        isMobile: boolean;
        reduceMotion: boolean;
      };

      const splitTitles = SplitText.create(".nav-title", { type: "chars" });

      if (reduceMotion) {
        gsap.set(
          [
            ".brand-text",
            ".footer-heading",
            ".cta-button",
            ".nav-column",
            ".nav-links li",
            ".footer-mail",
            ".effect",
          ],
          { opacity: 1, clearProps: "all" },
        );
        return () => {
          splitTitles.revert();
        };
      }

      const tl = gsap.timeline({ paused: isDesktop });

      tl.fromTo(
        ".brand-text",
        { autoAlpha: 0, y: isDesktop ? 120 : 60, scale: 0.92 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          ease: "power4.out",
        },
        0.95,
      );
      tl.fromTo(
        ".footer-mail",
        { autoAlpha: 0, y: isDesktop ? 120 : 60, scale: 0.92 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          ease: "power4.out",
        },
        1.1,
      );

      tl.fromTo(
        ".footer-heading",
        { autoAlpha: 0, y: 30 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
        },
        0.2,
      );

      tl.fromTo(
        ".cta-button",
        { autoAlpha: 0, x: isDesktop ? -50 : -25 },
        {
          autoAlpha: 1,
          x: 0,
          duration: 0.8,
          ease: "power3.out",
        },
        0.45,
      );

      tl.fromTo(
        ".nav-column",
        { autoAlpha: 0, y: 30, scale: 0.97 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          stagger: 0.12,
          ease: "power3.out",
        },
        0.35,
      );

      tl.fromTo(
        ".nav-links li",
        { autoAlpha: 0, x: -12 },
        {
          autoAlpha: 1,
          x: 0,
          duration: 0.8,
          stagger: 0.06,
          ease: "power2.out",
        },
        0.55,
      );

      tl.from(
        splitTitles.chars,
        {
          autoAlpha: 0,
          y: 16,
          duration: 0.8,
          stagger: 0.025,
          ease: "power2.out",
        },
        0.5,
      );

      tl.from(
        ".effect",
        {
          autoAlpha: 0,
          scale: 3.5,
          duration: 0.8,
          stagger: 0.05,
          ease: "power4.out",
        },
        "<",
      );

      if (isDesktop) {
        const onEnter = (e: any) => {
          if (e.detail?.id === "contact") tl.restart();
        };
        window.addEventListener("section:entered", onEnter);
        return () => {
          window.removeEventListener("section:entered", onEnter);
          splitTitles.revert();
        };
      } else {
        ScrollTrigger.create({
          trigger: ".section_footer",
          start: "top 55%",
          animation: tl,
          toggleActions: "play none none reverse",
        });
        return () => {
          splitTitles.revert();
        };
      }
    },
  );
</script>

<style>
  .effect {
    display: inline-block;
    margin-left: 1.2%;
    will-change: transform, opacity;
  }
  @media (max-width: 850px) {
    .section_footer {
      padding: 3rem 1rem 0rem !important;
    }
  }
</style>
