---
import "../style/header.css";
import Header from '../components/Header.astro';
import Favicon from '../../src/assets/logo.png';
import BlobAnimation from '../components/Background';
import '../style/header.css';
import 'aos/dist/aos.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={Favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<style>
/* Preloader container */
.preloader-container {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  pointer-events: auto;
  z-index: 1000;
  color: black;
  opacity: 1;
}

/* Top section (57%) */
.top-section {
  position: absolute;
  height: 57%;
  z-index: 2;
  background-color: #000;
  display: flex;
  align-items: flex-end;
  left: 0;
  right: 0;
  top: 0;
  padding-left: 5rem;
  padding-right: 5rem;
  clip-path: polygon(0% 0%, 100% 0%, 100% 99.5755%, 0% 99.5755%);
}

/* Bottom section (44%) */
.bottom-section {
  position: absolute;
  height: 44%;
  background-color: #000;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 5rem;
  display: flex;
  align-items: flex-end;
  text-align: center;
  clip-path: polygon(0% 0.4245%, 100% 0.4245%, 100% 100%, 0% 100%);
}

/* Logo container */
.logo-container {
  text-align: center;
  width: 100%;
  position: relative;
  opacity: 1;
}

/* Logos wrapper */
.logos-wrapper {
  overflow: hidden;
  width: 100%;
  margin-bottom: 2.5rem;
}

.logos-inner {
  display: flex;
  justify-content: center;
  width: 100%;
}

/* Individual logos */
.logo-left,
.logo-center,
.logo-right {
  display: inline-flex;
  align-items: center;
}

.logo-center{
  position: relative;
  margin-right: 0.5rem;
}

/* Progress container */
.progress-container {
  display: flex;
  justify-content: center;
  position: relative;
  overflow: hidden;
  height: 0.15rem;
  opacity: 1;
}

.progress-track {
  width: 100%;
  height: 100%;
  background-color: rgba(205, 205, 205, 0.65);
}

/* Progress bar */
.progress-bar {
  width: 100%;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  background-color: #fff;
  transform-origin: left;
  transform: scaleX(0);
}

/* Percentage container */
.percentage-container{
  overflow: hidden;
  width: 100%;
  opacity: 1;
}

/* Percentage text */
.percentage-text, #percentageText{
  font-size: 1.5rem;
  font-weight: 300;
  color: #fff;
}

.text-logo-preload {
  font-size: 4rem;
  color: white;
  font-family: 'Terra';
}
	</style>
	<body>
		<div
			id="preloader"
			class="preloader-container"
      style="background-color: #fff;"
		>

			<span id="topSection" class="top-section">
				<div id="logoContainer" class="logo-container">
					<div class="logos-wrapper">
						<div class="logos-inner">

							<div id="logoLeft" class="logo-left">
							  <span class="text-logo-preload">va</span>
							</div>


							<div id="logoCenter" class="logo-center">
								 <span class="text-logo-preload"> /</span>
							</div>


							<div id="logoRight" class="logo-right">
							  <span class="text-logo-preload">dev</span>
							</div>
						</div>
					</div>


					<div id="progressContainer" class="progress-container">
						<div class="progress-track"></div>
						<div id="progressBar" class="progress-bar"></div>
					</div>
				</div>
			</span>


			<span id="bottomSection" class="bottom-section">
				<div id="percentageContainer" class="percentage-container">
					<div>(<span id="percentageText">100%</span>)</div>
				</div>
			</span>
		</div>
		<BlobAnimation client:only/>
		<Header/>
		<main class="main main-viewport" id="main-viewport">
			<div class="sections-wrapper" id="sections-wrapper">
				<slot />
			</div>
		</main>
	</body>

	<!-- ── PRELOADER ──────────────────────────────────────────────────────────── -->
	<script>
		import { gsap } from "gsap/dist/gsap";


		const container          = document.getElementById("preloader");
		const leftLogo           = document.getElementById("logoLeft");
		const rightLogo          = document.getElementById("logoRight");
		const centerLogo         = document.getElementById("logoCenter");
		const progressBar        = document.getElementById("progressBar");
		const percentageText     = document.getElementById("percentageText");
		const topSection         = document.getElementById("topSection");
		const bottomSection      = document.getElementById("bottomSection");
		const logoContainer      = document.getElementById("logoContainer");
		const progressContainer  = document.getElementById("progressContainer");
		const percentageContainer = document.getElementById("percentageContainer");

		const cfg = {
			show:   { duration: 0.8, ease: "power3.inOut" },
			reveal: { duration: 2,   ease: "expo.inOut"   },
			hide:   { duration: 0.5, ease: "expo.inOut"   },
		};

		function start() {
			gsap.to([logoContainer, progressContainer, percentageContainer], {
				opacity: 1, duration: cfg.show.duration, ease: cfg.show.ease, delay: 0.2
			});

			const prog = { value: 0 };
			gsap.to(prog, {
				value: 100, duration: 2, delay: 0.5, ease: "power2.out",
				onUpdate: () => {
					gsap.set(progressBar, { scaleX: prog.value / 100 });
					if (percentageText) percentageText.textContent = `${Math.round(prog.value)}%`;
				},
				onComplete: introAnimation,
			});
		}

		function introAnimation() {
			gsap.delayedCall(0.3, () => {
				const tl = gsap.timeline({ onComplete: () => { gsap.delayedCall(0.5, exitAnimation); } });
				tl.to(leftLogo,   { x: -500, duration: cfg.reveal.duration, ease: cfg.reveal.ease });
				tl.to(rightLogo,  { x:  500, duration: cfg.reveal.duration, ease: cfg.reveal.ease }, 0);
				tl.to(centerLogo, { opacity: 0, duration: cfg.reveal.duration * 0.5, ease: "power2.out" }, cfg.reveal.duration * 0.5);
			});
		}

		function exitAnimation() {
			const tl = gsap.timeline({
				onComplete: () => {
					gsap.set(container, { autoAlpha: 0 });
					(window as any).__preloaderDone = true;
					window.dispatchEvent(new Event("preloader:finish"));
				}
			});
			tl.to(topSection,    { clipPath: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)",             duration: cfg.hide.duration, ease: cfg.hide.ease });
			tl.to(bottomSection, { clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)",      duration: cfg.hide.duration, ease: cfg.hide.ease }, 0);
			tl.to(container,     { opacity: 0, duration: 0.5 });
		}

		start();
	</script>

	<!-- ── SCROLL SYSTEM ──────────────────────────────────────────────────────── -->
	<script>
	import { gsap } from "gsap";
	import { Observer } from "gsap/Observer";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";

	gsap.registerPlugin(Observer, ScrollTrigger, ScrollToPlugin);

	const DESKTOP_MQ = "(min-width: 851px)";
	const REDUCE_MQ  = "(prefers-reduced-motion: reduce)";

	// Configuración global para mejor compatibilidad móvil
	ScrollTrigger.config({
		ignoreMobileResize: true, // Evita saltos por cambios en la barra de direcciones
	});

	function initScrollSystem() {
		// ── Teardown instancia anterior ─────────────────────────────────────────
		const prev = (window as any).__scrollTeardown as (() => void) | undefined;
		if (prev) prev();

		const sections = gsap.utils.toArray<HTMLElement>(".section");
		if (!sections.length) return;

		const mqlDesktop = window.matchMedia(DESKTOP_MQ);
		const mqlReduce  = window.matchMedia(REDUCE_MQ);
		const isDesktop    = () => mqlDesktop.matches;
		const reduceMotion = () => mqlReduce.matches;

		let currentIndex = 0;
		let isAnimating  = false;

		// mainObserver se crea más abajo; los sub-controladores horizontales
		// necesitan poder apagarlo/encenderlo, así que se referencia por adelantado.
		let mainObserver: ReturnType<typeof Observer.create> | null = null;

		// ── GSAP es la única fuente de verdad para visibilidad ──────────────────
		sections.forEach((s, i) => {
			s.classList.remove("active");
			gsap.set(s, i === 0
				? { autoAlpha: 1, yPercent: 0,   zIndex: 1 }
				: { autoAlpha: 0, yPercent: 100, zIndex: 0 }
			);
		});

		// ── Navegar entre secciones verticales (declarado antes de usarse) ──────
		let navigate: (direction: number) => void = () => {};

		// ── Sub-controladores "swipe panel" para secciones horizontales ─────────
		// Cada sección con data-type="horizontal" y elementos .panel gestiona su
		// propio Observer local, siguiendo el patrón de:
		// https://codepen.io/GreenSock/pen/MWGVJYL
		type PanelController = {
			enterFromStart: () => void;
			enterFromEnd: () => void;
			disable: () => void;
			kill: () => void;
		};
		const panelControllers = new Map<HTMLElement, PanelController>();

		function createPanelController(section: HTMLElement): PanelController | null {
			const panels = gsap.utils.toArray<HTMLElement>(".panel", section);
			if (!panels.length) return null;

			gsap.set(panels, {
				xPercent: (i: number) => (i === 0 ? 0 : 100),
				zIndex: (i: number) => i,
			});

			let panelIndex = 0;
			let panelAnimating = false;

			const gotoPanel = (index: number, isForward: boolean) => {
				panelAnimating = true;
				const target = isForward ? panels[index] : panels[panelIndex];
				gsap.to(target, {
					xPercent: isForward ? 0 : 100,
					duration: reduceMotion() ? 0 : 0.75,
					ease: "power3.inOut",
					onComplete: () => { panelAnimating = false; },
				});
				panelIndex = index;
			};

			const exitForward = () => {
				observer.disable();
				mainObserver?.enable();
				navigate(1);
			};
			const exitBackward = () => {
				observer.disable();
				mainObserver?.enable();
				navigate(-1);
			};

			const observer = Observer.create({
				type: "wheel,touch,pointer",
				target: section,
				wheelSpeed: -1,
				tolerance: 10,
				preventDefault: true,
				onPress: (self) => {
					ScrollTrigger.isTouch && self.event.preventDefault();
				},
				onUp: () => {
					if (panelAnimating) return;
					if (panelIndex >= panels.length - 1) { exitForward(); return; }
					gotoPanel(panelIndex + 1, true);
				},
				onDown: () => {
					if (panelAnimating) return;
					if (panelIndex <= 0) { exitBackward(); return; }
					gotoPanel(panelIndex - 1, false);
				},
			});
			observer.disable();

			return {
				enterFromStart: () => {
					panelIndex = 0;
					gsap.set(panels, { xPercent: (i: number) => (i === 0 ? 0 : 100) });
					mainObserver?.disable();
					observer.enable();
				},
				enterFromEnd: () => {
					panelIndex = panels.length - 1;
					gsap.set(panels, { xPercent: (i: number) => (i === panels.length - 1 ? 0 : 100) });
					mainObserver?.disable();
					observer.enable();
				},
				disable: () => observer.disable(),
				kill: () => observer.kill(),
			};
		}

		if (isDesktop() && !reduceMotion()) {
			sections.forEach((s) => {
				if (s.dataset.type === "horizontal") {
					const ctrl = createPanelController(s);
					if (ctrl) panelControllers.set(s, ctrl);
				}
			});
		}

		// ── Transición vertical entre secciones ─────────────────────────────────
		const animateSection = (nextIndex: number, direction: number) => {
			if (isAnimating) return;
			if (nextIndex === currentIndex) return;
			if (nextIndex < 0 || nextIndex >= sections.length) return;

			isAnimating = true;

			const cur       = sections[currentIndex];
			const next      = sections[nextIndex];
			const dur       = reduceMotion() ? 0 : 1.0;
			const prevIndex = currentIndex;

			gsap.set(next, { yPercent: direction > 0 ? 100 : -100, autoAlpha: 0, zIndex: 2 });
			gsap.set(cur,  { zIndex: 1 });

			currentIndex = nextIndex;

			const tl = gsap.timeline({
				onStart: () => {
					window.dispatchEvent(new CustomEvent("section:leaving", { detail: { id: cur.id } }));
				},
				onComplete: () => {
					gsap.set(cur, { autoAlpha: 0, zIndex: 0 });
					isAnimating = false;
					window.dispatchEvent(new CustomEvent("section:entered", { detail: { id: next.id } }));

					// Si aterrizamos en una sección horizontal, le pasamos el control
					// del Observer (entrando por el primer o el último panel según
					// la dirección de la navegación).
					const ctrl = panelControllers.get(next);
					if (ctrl) {
						direction > 0 ? ctrl.enterFromStart() : ctrl.enterFromEnd();
					}
				},
				onInterrupt: () => {
					isAnimating  = false;
					currentIndex = prevIndex;
				},
			});

			tl.to(cur,  { yPercent: direction > 0 ? -100 : 100, autoAlpha: 0, duration: dur, ease: "power3.inOut" }, 0);
			tl.to(next, { yPercent: 0, autoAlpha: 1,             duration: dur, ease: "power3.inOut" }, 0);
		};

		navigate = (direction: number) => {
			if (isAnimating) return;
			animateSection(currentIndex + direction, direction);
		};

		// ── Hash navigation ─────────────────────────────────────────────────────
		const findByHash = (hash: string) => {
			const id = hash.replace(/^#/, "");
			if (!id) return -1;
			return sections.findIndex((s) => s.id === id);
		};

		const goToHash = (hash: string) => {
			const idx = findByHash(hash);
			if (idx < 0) return;

			if (isDesktop() && !reduceMotion()) {
				if (idx === currentIndex) return;
				animateSection(idx, idx > currentIndex ? 1 : -1);
			} else {
				const section = sections[idx];
				if (section) {
					gsap.to(window, {
						duration: 0.6,
						ease: "power1.inOut",
						scrollTo: { y: section, autoKill: true },
					});
				}
			}
		};

		const onDocumentClick = (e: MouseEvent) => {
			const a = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href^="#"]');
			if (!a) return;
			const href = a.getAttribute("href") ?? "";
			if (href === "#" || href === "#!") {
				e.preventDefault();
				history.replaceState(null, "", "#home");
				goToHash("#home");
				return;
			}
			if (findByHash(href) >= 0) {
				e.preventDefault();
				history.replaceState(null, "", href);
				goToHash(href);
			}
		};
		document.addEventListener("click", onDocumentClick, true);

		// ── Observer / Snap — desktop vs mobile ─────────────────────────────────
		Observer.getAll().forEach((o) => o.kill());
		let snapTrigger: ReturnType<typeof ScrollTrigger.create> | null = null;
		let normalizer: ReturnType<typeof ScrollTrigger.normalizeScroll> | null = null;

		if (isDesktop() && !reduceMotion()) {
			mainObserver = Observer.create({
				type: "wheel,touch,pointer",
				wheelSpeed: -1,
				onUp:   () => !isAnimating && navigate(1),
				onDown: () => !isAnimating && navigate(-1),
				tolerance: 10,
				preventDefault: true,
			});

			// Si la primera sección es horizontal, entrégale el control desde ya.
			const firstCtrl = panelControllers.get(sections[0]);
			if (firstCtrl) firstCtrl.enterFromStart();
		} else {
			// Mobile / reduced-motion: scroll nativo con snap por sección
			sections.forEach((s) => {
				gsap.set(s, { position: "relative", autoAlpha: 1, yPercent: 0, zIndex: "auto", visibility: "visible" });
			});

			// Normaliza el scroll para evitar el efecto de "rebote" y parpadeo en móviles.
			// Sin inercia (momentum: 0): al ser secciones discretas, cualquier inercia
			// residual pelea contra el snap y produce saltos/overshoot no controlados.
			normalizer = ScrollTrigger.normalizeScroll({
				allowNestedScroll: true,
				momentum: () => 0,
			});

			// Snap equiespaciado — requiere que todas las .section tengan la misma altura
			snapTrigger = ScrollTrigger.create({
				trigger: sections[0],
				start: "top top",
				end: () => `+=${document.documentElement.scrollHeight - window.innerHeight}`,
				snap: {
					snapTo: 1 / (sections.length - 1),
					duration: { min: 0.25, max: 0.5 },
					delay: 0.05, // pequeño respiro para no chocar con el gesto en curso
					ease: "power1.inOut",
					inertia: false, // evita que un swipe fuerte se salte una sección
				},
			});

			ScrollTrigger.refresh();
		}

		// ── Resize ─────────────────────────────────────────────────────────────
		let resizeTimer: ReturnType<typeof setTimeout>;
		const handleResize = () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				ScrollTrigger.refresh();
				const wasDesktop = !!mainObserver;
				const nowDesktop = isDesktop() && !reduceMotion();
				if (wasDesktop !== nowDesktop) initScrollSystem();
			}, 200);
		};
		window.addEventListener("resize", handleResize);

		// ── Teardown ────────────────────────────────────────────────────────────
		const teardown = () => {
			mainObserver?.kill();
			panelControllers.forEach((ctrl) => ctrl.kill());
			panelControllers.clear();
			snapTrigger?.kill();
			normalizer?.kill();
			Observer.getAll().forEach((o) => o.kill());
			clearTimeout(resizeTimer);
			window.removeEventListener("resize", handleResize);
			document.removeEventListener("click", onDocumentClick, true);
			(window as any).__scrollTeardown = undefined;
		};
		(window as any).__scrollTeardown = teardown;

		// ── Hash inicial post-preloader ─────────────────────────────────────────
		const initialHash = window.location.hash;
		if (initialHash && findByHash(initialHash) >= 0) {
			const run = () => goToHash(initialHash);
			window.addEventListener("preloader:finish", run, { once: true });
			setTimeout(run, 100);
		}
	}

	document.addEventListener("DOMContentLoaded", initScrollSystem);
	document.addEventListener("astro:page-load",   initScrollSystem);
	</script>

</html>